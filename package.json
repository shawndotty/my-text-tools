		"@codemirror/search": "^6.6.0",
		"@codemirror/state": "^6.5.4",
		"@codemirror/view": "^6.39.11",
		"@eslint/js": "9.30.1",
		"@lezer/common": "^1.5.0",
		"@lezer/highlight": "^1.2.3",
		"@lezer/lr": "^1.4.7",
		"@types/node": "^16.11.6",
		"esbuild": "0.25.5",
		"eslint-plugin-obsidianmd": "0.1.9",
		"globals": "14.0.0",
		"jiti": "2.6.1",
